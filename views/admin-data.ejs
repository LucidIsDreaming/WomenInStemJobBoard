<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Data</title>

    <link rel="icon" href="images/favicon.png">
    
    <!-- Add data table resources -->
    <script src = "https://code.jquery.com/jquery-3.7.1.js"></script> <!--JQuery HAS TO COME FIRST!!!-->
    <script src = "https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <!--CSS-->
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <!--favicon-->
    <link rel="icon" href="images/admin-favicon.png">
</head>


<body>
        <h1>Jobs Posted</h1>

    <table id = "jobs-table" class = "display">
        <thead>
            <tr>
                <th>Job Title</th>
                <th>Company</th>
                <th>Trade Area</th>
                <th>Location</th>
                <th>Part time or full time</th>
                <th>Date Posted</th>
                <th>Expiration Date</th>
                <th>Application URL</th>
]            </tr>
        </thead>
        <tbody>
    <% jobs.forEach(job => { %>
        <tr>
            <td><%= job.jobTitle %></td>
            <td><%= job.companyName %></td>
            <td><%= job.tradeArea %></td>
            <td><%= job.location %></td>
            <td><%= job.method %></td>
            <td><%= job.datePosted %></td>
            <td><%= job.expDate %></td>
            <td><%= job.appUrl %></td>
        </tr>
    <% }); %>
        </tbody>
    </table>

    <script>
        new DataTable('#jobs-table');
    </script>

    
</body>
</html>