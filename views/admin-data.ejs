<!DOCTYPE html>
<html lang="en">
<head>
     <%- include("partials/head.ejs") %>
    
    <!-- Add data table resources -->
    <script src = "https://code.jquery.com/jquery-3.7.1.js"></script> <!--JQuery HAS TO COME FIRST!!!-->
    <script src = "https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
     <link rel="stylesheet" href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css">
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>
    <!--CSS-->
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <!--favicon-->
    <link rel="icon" href="images/admin-favicon.png">
</head>

<!-- admin data  -->
<body>
        <h1>Jobs Posted</h1>

    <table id = "jobs-table" class = "display">
        <thead>
            <tr>
                <th>Job Title</th>
                <th>Company</th>
                <th>Trade Area</th>
                <th>Location</th>
                <th>Part time or full time</th>
                <th>Internship</th>
                <th>Date Posted</th>
                <th>Expiration Date</th>
                <th>Application URL</th>
            </tr>
        </thead>
        <tbody>
    <% jobs.forEach(job => { %>
        <tr>
            <td><%= job.jobTitle %></td>
            <td><%= job.companyName %></td>
            <td><%= job.tradeArea %></td>
            <td><%= job.location %></td>
            <td><%= job.method %></td>
            <td><%= job.internMethod %></td>
            <td><%= job.datePosted.toDateString() %></td>
            <td><%= job.expDate.toDateString() %></td>
            <td><%= job.appUrl %></td>
            
        </tr>
    <% }); %>
        </tbody>
    </table>

    <script>
        new DataTable('#jobs-table',{
            responsive:true,
            order: [[6, 'desc']]
        });
    </script>

    <a href="/" class = "main-button">Back to Job Postings</a>
    
</body>
</html>