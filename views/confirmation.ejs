<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="images/favicon.png">
    <title>Confirmation</title>  
    <!-- <script src="scripts/trades.js" defer></script> -->
    <!-- Add data table resources -->
    <script src = "https://code.jquery.com/jquery-3.7.1.js"></script> <!--JQuery HAS TO COME FIRST!!!-->
    <script src = "https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <!--CSS-->
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    
    
    
</head>
<body>
    <h>Job Posted!</h>

    <table id="confirm-table" class="display">
        <thead>
            <tr>
                <th>Job Title</th>
                <th>Company</th>
                <th>Trade Area</th>
                <th>Location</th>
                <th>Part time or Full time</th>
                <th>Date Posted</th>
                <th>Expiration Date</th>
                <th>URL</th>
            </tr>
        </thead>
        <tbody>
            <tr>
            <td><%= job.jobTitle %></td>
            <td><%= job.companyName %></td>
            <td><%= job.tradeArea %></td>
            <td><%= job.location %></td>
            <td><%= job.method %></td>
            <td><%= job.datePosted %></td>
            <td><%= job.expDate %></td>
            <td><%= job.appUrl %></td>
           </tr> 
        </tbody>
    </table>

        <script>
        new DataTable('#confrim-table');
    </script>

     <a href="/" class = "main-button">Back to Home Page</a>
    <a href="/admin-data" class = "admin-data-button">See Recent Admin Data</a>
</body>
</html>