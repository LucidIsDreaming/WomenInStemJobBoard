<!DOCTYPE html>
<html lang="en">
<head>
        <%- include("partials/head.ejs") %>
    <link rel= "stylesheet" href= "styles/home-styles.css">
    <!-- <script src="scripts/trades.js" defer></script> -->
    <script src = "https://code.jquery.com/jquery-3.7.1.js"></script> <!--JQuery HAS TO COME FIRST!!!-->
    <script src = "https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css">

<script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>
    <!--CSS-->
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
        


</head>
<body>
   <div id="main">
    <div id="header">
        <div class = "image-layer">
            <img src="images/green-river.png" class = "logo" alt = "greenriver logo">
            <img src="images/Green_River_campus_bg.jpg" class = "background" alt = "a green globe with grass in the background">
            <div class = "text-layer">
            <h1>Trades</h1>
            <h3>Job Board</h3>
            </div>
            <div>
                 <p><a href="https://www.greenriver.edu/students/academics/areas-of-interest/program-maps/trades-industrial-tech-aviation-natural-resources/index.html" target="_blank" id="grc-button">GRC Trades</a></p>
            </div>
        </div>
    </div>
    <table id="home-table" class="display">
        <thead>
            <tr>
                 <th>Job Title</th>
                <th>Company</th>
                <th>Trade Area</th>
                <th>Location</th>
                <th>Part time or full time</th>
                <th>Internship</th>
                <th>Date Posted</th>
                <th>Expiration Date</th>
                <th>Application URL</th>
            </tr>
        </thead>
         <tbody>
           
            <% jobs.forEach(job => {%>
            <% const today = new Date(); %>
            <% if(job.expDate >= today) {%>
            <tr>
                <td><%= job.jobTitle %></td>
                <td><%= job.companyName %></td>
                <td><%= job.tradeArea %></td>
                <td><%= job.location %></td>
                <td><%= job.method %></td>
                <td><%= job.internMethod %></td>
                <td><%= job.datePosted %></td>
                <td><%= job.expDate %></td>
                <td id="button-td"><a href="<%= job.appUrl %>" target="_blank" id="apply-button">Apply</a></td>             
                </tr>
                <%}%>
            <%}); %>
        </tbody>
    </table>

    
    <script>
        new DataTable('#home-table', {
            responsive: true,
            order: [[6, 'desc']]
        });
    </script>
   
   <a href="/admin" id="admin-button">Admin Page</a>
</body>
</html>

