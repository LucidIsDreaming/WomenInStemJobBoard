<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel = "stylesheet" href = "/styles/home-styles.css">
        <link rel="icon" href="images/favicon.png">
    <link rel= "stylesheet" href= "styles/home-styles.css">

    <!-- <script src="scripts/trades.js" defer></script> -->
    <script src = "https://code.jquery.com/jquery-3.7.1.js"></script> <!--JQuery HAS TO COME FIRST!!!-->
    <script src = "https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <!--CSS-->
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
        <title>Job Board</title>


</head>
<body>
   <div id="main">
    <div id="header">
        <div class = "image-layer">
            <img src="images/green-river.png" class = "logo" alt = "greenriver logo">
            <img src="images/trades-background.png" class = "background" alt = "a green globe with grass in the background">
            <div class = "text-layer">
            <h1>Trades</h1>
            <h3>Job Board</h3>
            </div>
        </div>
    </div>
    <table id="home-table" class="display">
        <thead>
            <tr>
                 <th>Job Title</th>
                <th>Company</th>
                <th>Trade Area</th>
                <th>Location</th>
                <th>Part time or full time</th>
                <th>Date Posted</th>
                <th>Expiration Date</th>
                <th>Application URL</th>
            </tr>
        </thead>
        <tbody>

             <tr>
                <td>Mechanic I, Vehicle Maintenance</td>
                <td>Crystal Mountain</td>
                <td>Automotive</td>
                <td>Enumclaw, WA</td>
                <td>Full time</td>
                <td>2026-10-01</td>
                <td>N/A</td>
                <td id="button-td"><a href="https://alterra.wd1.myworkdayjobs.com/en-US/CrystalMountain/job/Mechanic-I--Vehicle-Maintenance_JR134594?source=CareerSite&_gl=1*334yzx*_ga*MTI0ODcwMDQ2NS4xNzkzODQ4Mzc2*_ga_756V9GY6NW*czE3OTM4NDgzNzYkbzEkZzAkdDE3OTM4NDgzNzgkajU4JGwwJGgw*_gcl_au*ODUyNTIxMTY4LjE3OTM4NDgzNzY." id="apply-button" target="_blank">Apply</a></td>
            </tr>

            <tr>
                <td>General Service Technician</td>
                <td>JiffyLube</td>
                <td>Automotive</td>
                <td>Seattle, WA</td>
                <td>Full time</td>
                <td>2026-11-04</td>
                <td>N/A</td>
                <td id="button-td"><a href="https://teamcarcare.wd1.myworkdayjobs.com/en-US/External/job/Seattle%2C-Washington/General-Service-Technician_JR114759" id="apply-button" target="_blank">Apply</a></td>
            </tr>

           
            <% jobs.forEach(job => {%>
            <tr>
                <td><%= job.jobTitle %></td>
                <td><%= job.companyName %></td>
                <td><%= job.tradeArea %></td>
                <td><%= job.location %></td>
                <td><%= job.method %></td>
                <td><%= job.datePosted %></td>
                <td><%= job.expDate %></td>
                <td id="button-td"><a href="<%= job.appUrl %>" target="_blank" id="apply-button">Apply</a></td>              
                </tr>
            <%}); %>
        </tbody>
    </table>

    <script>
        new DataTable('#jobs-table');
    </script>
   
   <a href="/admin" id="admin-button">Admin Page</a>
</body>
</html>

