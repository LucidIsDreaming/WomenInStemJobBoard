<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post a Job</title>
    <link rel="stylesheet" href="styles/job-posting-form.css">
    <script src="scripts/trades.js" defer></script>
</head>
<body>
                <form id="job-form" action="/submit-job" method="post">
                   

                   

            <!-- contact info -->
             <div id="form-body">
             <fieldset>
                 <div id="form-title">
                <legend>Create a job Post</legend>
                </div>
                <!-- job title -->
                 <span class="err" id="err-job-title">Job Title Required </span>
                <legend for="job-title">Job Title:</legend>
                <input type="text" id="job-title" name="job-title"> 
                
                <!-- Company name -->
                 <span class="err" id="err-company-name">Company Name Required</span>
                <legend for="company-name">Company Name:</legend>
                <input type="text" id="company-name" name="company-name">
                
                <!-- Trade area -->
                 <span class="err" id="err-trade-area">Trade Program Required </span>
                <legend for="text">Trade Area</legend>
                <input type="text" id="trade-area" name="trade-area">

                <!-- location -->
                 <span class="err" id="err-location">Location Required</span>
                 <legend for="text">Location</legend>
                <input type="text" id="location" name="location">

                <!-- part or full time -->
                 <legend for="part-time">
                    <input type="radio" id="part-time" name="part-time" value="part-time">
                    Part TIme
                 </legend>
                <legend for="full-time"
                >
                <input type="radio" id="full-time" name="full-time" value="full-time">
                Full Time
                </legend>

                <!-- date posted -->
                 <span class="err" id="err-date">Date Posted Required </span>
                <legend for="text">Date posted</legend>
                <input type="text" id="date-posted" name="date-posted">

                <!-- date expires -->
                <span class="err" id="err-exp">Expiration Date Required</span>
                <legend for="text">Expiration date</legend>
                <input type="text" id="exp-date" name="exp-date">

                <!-- application url -->
                <span class="err" id="err-app-url">Application URL Required </span>
                  <legend for="text">Application URL</legend>
                <input type="text" id="app-url" name="app-url">

             </fieldset>

            
             
             <button type="submit" id="submit-button">Post Job</button>
        </form>
        </div>
</body>
</html>