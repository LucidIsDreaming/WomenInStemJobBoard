<!DOCTYPE html>
<html lang="en">

<head>
 <%- include("partials/head.ejs") %>
  <link rel="stylesheet" href="styles/post-form.css">
  <script src="scripts/trades.js" defer></script>

  <link rel="icon" href="images/favicon.png">

</head>

<body>
  <form id="job-form" action="/submit-job" method="post">




    <!-- contact info -->
    <div id="form-body">
      <fieldset>

        <legend>Create a job Post</legend>

        <!-- job title -->
        <div class="inputs">
          <span class="err" id="err-job-title">Job Title Required </span>
          <label for="job-title">Job Title:</label>
          <input type="text" id="job-title" name="jobTitle">
        </div>

        <!-- Company name -->
        <div class="inputs">
          <span class="err" id="err-company-name">Company Name Required</span>
          <label for="company-name">Company Name:</label>
          <input type="text" id="company-name" name="companyName">
        </div>

        <!-- Trade area -->
        <div class="inputs">
          <span class="err" id="err-trade-area">Trade Program Required </span>
          <label for="trade-area">Trade Area</label>
          <select id="trade-area" name="tradeArea">
            <option value="none">Choose a trade</option>
                    <option value="welding">Welding</option>
                    <option value="automotive">Automotive</option>
                    <option value="carpentry">Carpentry</option>
                    <option value="manufacturing">Manufacturing</option>
                    <option value="mechatronics">Mechatronics</option>
                </select>
        </div>

        <!-- location -->
        <div class="inputs">
          <span class="err" id="err-location">Location Required</span>
          <label for="location">Location</label>
          <input type="text" id="location" name="location">
        </div>

        <!-- part or full time -->
        <div class="inputs">
          <span class="err" id="err-type">Part or Full time Required</span>
          <label for="part-time">Part Time</label>
          <input type="radio" id="part-time" name="method" value="Part Time">

          <label for="full-time">Full Time</label>
          <input type="radio" id="full-time" name="method" value="Full Time">
        </div>

        <!-- Internship yes or no -->
        <div class="inputs">
          <label for="trade-area">Internship:</label>
          <span class="err" id="err-type">Internship Required</span>
          <label for="internship-yes">Yes</label>
          <input type="radio" id="internsip-yes" name="internMethod" value="yes">

          <label for="internship-no">No</label>
          <input type="radio" id="internship-no" name="internMethod" value="no">
        </div>



        <!-- date posted -->
        <div class="inputs">
          <span class="err" id="err-date">Date Posted Required </span>
          <label for="date-posted">Date posted</label>
          <input type="date" id="date-posted" name="datePosted">
        </div>

        <!-- date expires -->
        <div class="inputs">
          <span class="err" id="err-exp">Expiration Date Required</span>
          <label for="exp-date">Expiration date</label>
          <input type="date" id="exp-date" name="expDate">
        </div>

        <!-- application url -->
        <div class="inputs">
          <span class="err" id="err-app-url">Application URL Required </span>
          <label for="app-url">Application URL</label>
          <input type="text" id="app-url" name="appUrl">
        </div>

        <button type="submit" id="submit-button">Post Job</button>
      </fieldset>
    </div>
  </form>

</body>

</html>